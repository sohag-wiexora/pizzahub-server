# ─────────────── Server ───────────────
NODE_ENV=development
PORT=5000

# ─────────────── Database ───────────────
# MongoDB Atlas connection string (keep username & password secret)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/pizzahub?retryWrites=true&w=majority

# ─────────────── Client / CORS ───────────────
# Comma separated list of allowed frontend origins (no trailing slash)
CLIENT_URL=http://localhost:3000

# ─────────────── Better Auth ───────────────
# Public URL of THIS API (Render/Railway URL in production)
BETTER_AUTH_URL=http://localhost:5000
# Random secret of at least 32 characters (e.g. `openssl rand -base64 32`)
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-value
# Optional override — defaults to ${BETTER_AUTH_URL}/api/auth/jwks
# JWT_JWKS_URL=

# ─────────────── Google OAuth ───────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth Client ID (Web)
# Authorized redirect URI: http://localhost:5000/api/auth/callback/google
# (add the production URL variant too: https://<your-api>/api/auth/callback/google)
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx

# ─────────────── ImgBB ───────────────
# Menu item images are uploaded through POST /api/v1/uploads/image
IMGBB_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────── Stripe (Premium subscription) ───────────────
# Secret key from the Stripe dashboard (test mode: sk_test_...)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
# Webhook signing secret (stripe listen / dashboard endpoint: whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx
# Stripe Price ID of the monthly Premium subscription plan (price_...)
STRIPE_PREMIUM_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxxx

# ─────────────── Admin seed script ───────────────
# `npm run seed:admin` creates the admin account through Better Auth.
# Password rule: 6+ characters with one uppercase and one lowercase letter.
ADMIN_NAME=PizzaHub Admin
ADMIN_EMAIL=admin@pizzahub.com
ADMIN_PASSWORD=Admin123
